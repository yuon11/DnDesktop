<Page x:Class="DnDesktop.CampaignEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Campaign Editor">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">

            <TextBlock x:Name="PageTitleText"
                       Text="Create Campaign"
                       FontSize="26"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Campaign Name *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="NameTextBox"
                     Padding="8"
                     MaxLength="200"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Description"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="DescriptionTextBox"
                     Padding="8"
                     MinHeight="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Campaign Notes"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="CampaignNotesTextBox"
                     Padding="8"
                     MinHeight="120"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,20"/>

            <GroupBox Header="Main Party"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Select an existing character to add to the party."
                               Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Add Character"
                                Click="AddPartyMember_Click"
                                Padding="10,5"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"/>

                        <ComboBox x:Name="PartyCharacterComboBox"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="PartyMembersListBox"
                             DisplayMemberPath="Name"
                             MinHeight="90"
                             MaxHeight="180"/>

                    <Button Content="Remove Selected Party Member"
                            Click="RemovePartyMember_Click"
                            HorizontalAlignment="Right"
                            Padding="10,5"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="NPCs"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Select an existing character to add as an NPC."
                               Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Add NPC"
                                Click="AddNPC_Click"
                                Padding="10,5"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"/>

                        <ComboBox x:Name="NPCCharacterComboBox"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="NPCsListBox"
                             DisplayMemberPath="Name"
                             MinHeight="90"
                             MaxHeight="180"/>

                    <Button Content="Remove Selected NPC"
                            Click="RemoveNPC_Click"
                            HorizontalAlignment="Right"
                            Padding="10,5"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Locations"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock
                        Text="Select an existing location to associate it with this campaign."
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"/>

                    <DockPanel Margin="0,0,0,10">
                        <Button Content="Add Location"
                                Click="AddLocation_Click"
                                Padding="10,5"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"/>

                        <ComboBox x:Name="LocationComboBox"
                                  DisplayMemberPath="Name"
                                  VerticalContentAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="CampaignLocationsListBox"
                             DisplayMemberPath="Name"
                             MinHeight="90"
                             MaxHeight="180"/>

                    <Button Content="Remove Selected Location"
                            Click="RemoveLocation_Click"
                            HorizontalAlignment="Right"
                            Padding="10,5"
                            Margin="0,8,0,0"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Quests"
          Padding="10"
          Margin="0,0,0,15">
                <StackPanel>
                    <ListView x:Name="QuestsListView"
                  MinHeight="120"
                  MaxHeight="250"
                  SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Quest"
                                    Width="200"
                                    DisplayMemberBinding="{Binding Name}"/>

                                <GridViewColumn Header="Status"
                                    Width="110"
                                    DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
                        <Button Content="Create Quest"
                    Click="CreateQuest_Click"
                    Padding="10,5"
                    Margin="4"/>

                        <Button Content="Edit Quest"
                    Click="EditQuest_Click"
                    Padding="10,5"
                    Margin="4"/>

                        <Button Content="Delete Quest"
                    Click="DeleteQuest_Click"
                    Padding="10,5"
                    Margin="4"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Sessions"
                      Padding="10"
                      Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock
                        Text="Manage the sessions associated with this campaign."
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"/>

                    <ListView x:Name="SessionsListView"
                              MinHeight="120"
                              MaxHeight="250"
                              SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Session"
                                                Width="200"
                                                DisplayMemberBinding="{Binding Title}"/>

                                <GridViewColumn Header="Date"
                                                Width="130"
                                                DisplayMemberBinding="{Binding SessionDate, StringFormat={}{0:MMM d, yyyy}}"/>

                                <GridViewColumn Header="Status"
                                                Width="110"
                                                DisplayMemberBinding="{Binding Status}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,10,0,0">
                        <Button Content="Create Session"
                                Click="CreateSession_Click"
                                Padding="10,5"
                                Margin="4"/>

                        <Button Content="Edit Session"
                                Click="EditSession_Click"
                                Padding="10,5"
                                Margin="4"/>

                        <Button Content="Delete Session"
                                Click="DeleteSession_Click"
                                Padding="10,5"
                                Margin="4"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,5,0,10">
                <Button Content="Save Campaign"
                        Click="SaveCampaign_Click"
                        Padding="15,8"
                        Margin="5"/>

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="15,8"
                        Margin="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
