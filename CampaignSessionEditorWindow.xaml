<Window x:Class="DnDesktop.CampaignSessionEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Campaign Session"
        Height="850"
        Width="760"
        MinHeight="600"
        MinWidth="600"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel Margin="24"
                        MaxWidth="850"
                        HorizontalAlignment="Stretch">

                <TextBlock Text="Campaign Session"
                           FontSize="24"
                           FontWeight="Bold"
                           Margin="0,0,0,20"/>

                <!-- Session details -->
                <GroupBox Header="Session Details"
                          Padding="12"
                          Margin="0,0,0,16">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Content="Title *"/>

                        <TextBox x:Name="TitleTextBox"
                                 Grid.Row="0"
                                 Grid.Column="1"
                                 Margin="4"
                                 Padding="6"/>

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Content="Session Date"/>

                        <DatePicker x:Name="SessionDatePicker"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="4"
                                    Padding="4"/>

                        <Label Grid.Row="2"
                               Grid.Column="0"
                               Content="Status"/>

                        <ComboBox x:Name="StatusComboBox"
                                  Grid.Row="2"
                                  Grid.Column="1"
                                  Margin="4"
                                  Padding="5">

                            <ComboBoxItem Content="Planned"/>
                            <ComboBoxItem Content="In Progress"/>
                            <ComboBoxItem Content="Completed"/>

                        </ComboBox>

                        <Label Grid.Row="3"
                               Grid.Column="0"
                               Content="Summary"/>

                        <TextBox x:Name="SummaryTextBox"
                                 Grid.Row="3"
                                 Grid.Column="1"
                                 Margin="4"
                                 Padding="6"
                                 MinHeight="70"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <Label Grid.Row="4"
                               Grid.Column="0"
                               Content="Session Notes"/>

                        <TextBox x:Name="SessionNotesTextBox"
                                 Grid.Row="4"
                                 Grid.Column="1"
                                 Margin="4"
                                 Padding="6"
                                 MinHeight="140"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                    </Grid>
                </GroupBox>

                <!-- Encounter management -->
                <GroupBox x:Name="EncountersSection"
                          Header="Encounters"
                          Padding="12"
                          Margin="0,0,0,16">

                    <StackPanel>

                        <TextBlock
                            Text="Manage combat encounters planned for this session."
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"/>

                        <ListView x:Name="EncountersListView"
                                  MinHeight="120"
                                  MaxHeight="220"
                                  SelectionMode="Single">

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Header="Encounter"
                                        Width="450"
                                        DisplayMemberBinding="{Binding Name}"/>
                                </GridView>
                            </ListView.View>

                        </ListView>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="0,10,0,0">

                            <Button Content="Create Encounter"
                                    Click="CreateEncounter_Click"
                                    Padding="10,5"
                                    Margin="4"/>

                            <Button Content="Edit Encounter"
                                    Click="EditEncounter_Click"
                                    Padding="10,5"
                                    Margin="4"/>

                            <Button Content="Delete Encounter"
                                    Click="DeleteEncounter_Click"
                                    Padding="10,5"
                                    Margin="4"/>

                        </StackPanel>

                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Session actions -->
        <Border Grid.Row="1"
                BorderThickness="0,1,0,0"
                BorderBrush="LightGray"
                Padding="16">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Content="Save"
                        Click="Save_Click"
                        IsDefault="True"
                        MinWidth="100"
                        Padding="12,6"
                        Margin="4"/>

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        IsCancel="True"
                        MinWidth="100"
                        Padding="12,6"
                        Margin="4"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
