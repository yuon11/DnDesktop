<Page x:Class="DnDesktop.CampaignsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Campaigns">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="Campaigns"
                       FontSize="28"
                       FontWeight="Bold"/>

            <TextBlock Text="Manage your adventures, party members, quests, and encounters."
                       FontSize="14"
                       Margin="0,5,0,0"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ListView x:Name="CampaignsListView"
                  Grid.Row="1"
                  SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Campaign Name"
                                    Width="220"
                                    DisplayMemberBinding="{Binding Name}"/>

                    <GridViewColumn Header="Description"
                                    Width="350"
                                    DisplayMemberBinding="{Binding Description}"/>

                    <GridViewColumn Header="Last Modified"
                                    Width="150"
                                    DisplayMemberBinding="{Binding LastModified,
                                        StringFormat={}{0:g}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Create Campaign"
                    Click="CreateCampaign_Click"
                    Padding="12,7"
                    Margin="5"/>

            <Button Content="Edit Campaign"
                    Click="EditCampaign_Click"
                    Padding="12,7"
                    Margin="5"/>

            <Button Content="Delete Campaign"
                    Click="DeleteCampaign_Click"
                    Padding="12,7"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Page>
