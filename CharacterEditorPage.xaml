<Page x:Class="DnDesktop.CharacterEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DnDesktop"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CharacterEditorPage">


    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>

            </Grid.RowDefinitions>


            <!-- Header -->

            <TextBlock x:Name="PageTitle"
                       Grid.Row="0"
                       Text="Create Character"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,25"/>


            <!-- Name -->

            <StackPanel Grid.Row="1"
                        Margin="0,0,0,15">

                <TextBlock Text="Character Name"
                           FontWeight="Bold"/>

                <TextBox x:Name="NameTextBox"
                         Height="30"
                         Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Player -->

            <StackPanel Grid.Row="2"
                        Margin="0,0,0,15">

                <TextBlock Text="Player Name"
                           FontWeight="Bold"/>

                <TextBox x:Name="PlayerNameTextBox"
                         Height="30"
                         Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Race / Class -->

            <Grid Grid.Row="3"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Race"
                               FontWeight="Bold"/>

                    <TextBox x:Name="RaceTextBox"
                             Height="30"
                             Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">

                    <TextBlock Text="Class"
                               FontWeight="Bold"/>

                    <TextBox x:Name="ClassTextBox"
                             Height="30"
                             Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Subrace / Subclass -->

            <Grid Grid.Row="4"
                  Margin="0,0,0,15">

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>


                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Subrace"
                               FontWeight="Bold"/>

                    <TextBox x:Name="SubraceTextBox"
                             Height="30"
                             Margin="0,5,0,0"/>

                </StackPanel>


                <StackPanel Grid.Column="1"
                            Margin="10,0,0,0">

                    <TextBlock Text="Subclass"
                               FontWeight="Bold"/>

                    <TextBox x:Name="SubclassTextBox"
                             Height="30"
                             Margin="0,5,0,0"/>

                </StackPanel>

            </Grid>


            <!-- Level -->

            <StackPanel Grid.Row="5"
                        Margin="0,0,0,15">

                <TextBlock Text="Level"
                           FontWeight="Bold"/>

                <TextBox x:Name="LevelTextBox"
                         Height="30"
                         Width="100"
                         HorizontalAlignment="Left"
                         Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Background -->

            <StackPanel Grid.Row="6"
                        Margin="0,0,0,15">

                <TextBlock Text="Background"
                           FontWeight="Bold"/>

                <TextBox x:Name="BackgroundTextBox"
                         Height="30"
                         Margin="0,5,0,0"/>

            </StackPanel>


            <!-- Buttons -->

            <StackPanel Grid.Row="7"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0">

                <Button Content="Cancel"
                        Width="100"
                        Height="35"
                        Margin="0,0,10,0"
                        Click="Cancel_Click"/>

                <Button Content="Save Character"
                        Width="140"
                        Height="35"
                        Click="SaveCharacter_Click"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</Page>