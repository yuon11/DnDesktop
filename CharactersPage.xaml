<Page x:Class="DnDesktop.CharactersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DnDesktop"
      mc:Ignorable="d"
      d:DesignHeight="650"
      d:DesignWidth="1000"
      Title="Characters"
      Loaded="CharactersPage_Loaded">

    <Page.Resources>

        <!-- Loads an image from its managed file path -->
        <local:ImagePathToBitmapConverter
            x:Key="ImagePathToBitmapConverter"/>

        <!-- Character card appearance -->
        <Style x:Key="CharacterCardStyle"
               TargetType="{x:Type ListBoxItem}">

            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">

                        <Border x:Name="CardBorder"
                                Background="White"
                                BorderBrush="#DDDDDD"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">

                            <ContentPresenter/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#3978B8"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="3"/>
                            </Trigger>

                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#6699CC"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Page.Resources>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page header and actions -->
        <DockPanel Grid.Row="0"
                   Margin="0,0,0,15">

            <TextBlock Text="Characters"
                       FontSize="26"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       DockPanel.Dock="Left"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right">

                <Button Content="Create"
                        Width="85"
                        Margin="4"
                        Click="CreateCharacter_Click"/>

                <Button Content="Edit"
                        Width="85"
                        Margin="4"
                        Click="EditCharacter_Click"/>

                <Button Content="Delete"
                        Width="85"
                        Margin="4"
                        Click="DeleteCharacter_Click"/>

            </StackPanel>

        </DockPanel>

        <!-- Character cards -->
        <ListBox x:Name="CharacterList"
                 Grid.Row="1"
                 ItemsSource="{Binding Characters}"
                 SelectedItem="{Binding SelectedCharacter, Mode=TwoWay}"
                 ItemContainerStyle="{StaticResource CharacterCardStyle}"
                 BorderThickness="0"
                 Background="Transparent"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 MouseDoubleClick="CharacterList_MouseDoubleClick">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemTemplate>
                <DataTemplate>

                    <Grid Width="260"
                          Height="300">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="155"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Primary character image or placeholder -->
                        <Grid Grid.Row="0"
                              Background="#E8E8E8">

                            <Image Source="{Binding PrimaryImagePath,
                                    Converter={StaticResource ImagePathToBitmapConverter}}"
                                   Stretch="UniformToFill"/>

                            <TextBlock Text="No image available"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#666666"
                                       FontSize="13">

                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">

                                        <Setter Property="Visibility"
                                                Value="Collapsed"/>

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding PrimaryImagePath}"
                                                Value="{x:Null}">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>

                                            <DataTrigger
                                                Binding="{Binding PrimaryImagePath}"
                                                Value="">
                                                <Setter Property="Visibility"
                                                        Value="Visible"/>
                                            </DataTrigger>

                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>

                            </TextBlock>

                        </Grid>

                        <!-- Character details -->
                        <StackPanel Grid.Row="1"
                                    Margin="12,10">

                            <TextBlock Text="{Binding Name}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding Name}"/>

                            <TextBlock Text="{Binding Race}"
                                       Foreground="#3978B8"
                                       FontSize="12"
                                       Margin="0,3,0,5"/>

                            <TextBlock Text="{Binding CharacterClass}"
                                       Foreground="#444444"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding CharacterClass}"/>

                            <TextBlock Margin="0,7,0,0"
                                       Foreground="#666666"
                                       FontSize="11"
                                       Text="{Binding Level,
                                           StringFormat='Level: {0}'}"/>

                            <TextBlock Margin="0,3,0,0"
                                       Foreground="#666666"
                                       FontSize="11"
                                       Text="{Binding PlayerName,
                                           StringFormat='Player: {0}'}"/>

                        </StackPanel>

                    </Grid>

                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

    </Grid>
</Page>
