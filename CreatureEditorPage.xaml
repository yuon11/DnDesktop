<Page x:Class="DnDesktop.CreatureEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="900"
      d:DesignWidth="900"
      Title="CreatureEditorPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24"
              MaxWidth="900"
              HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Page title -->
            <TextBlock x:Name="EditorTitle"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Create Creature"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Identity section -->
            <GroupBox Grid.Row="1"
                      Grid.ColumnSpan="2"
                      Header="Creature Identity"
                      Padding="12"
                      Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Content="Name *"/>

                    <TextBox x:Name="NameTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Content="Creature Type"/>

                    <ComboBox x:Name="CreatureTypeComboBox"
                              Grid.Row="1" Grid.Column="1"
                              Margin="4" Padding="5"
                              IsEditable="True"
                              Text="Other"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Other"/>
                        <ComboBoxItem Content="Aberration"/>
                        <ComboBoxItem Content="Beast"/>
                        <ComboBoxItem Content="Celestial"/>
                        <ComboBoxItem Content="Construct"/>
                        <ComboBoxItem Content="Dragon"/>
                        <ComboBoxItem Content="Elemental"/>
                        <ComboBoxItem Content="Fey"/>
                        <ComboBoxItem Content="Fiend"/>
                        <ComboBoxItem Content="Giant"/>
                        <ComboBoxItem Content="Humanoid"/>
                        <ComboBoxItem Content="Monstrosity"/>
                        <ComboBoxItem Content="Ooze"/>
                        <ComboBoxItem Content="Plant"/>
                        <ComboBoxItem Content="Undead"/>
                    </ComboBox>

                    <Label Grid.Row="2" Grid.Column="0"
                           Content="Subtype"/>

                    <TextBox x:Name="SubtypeTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="3" Grid.Column="0"
                           Content="Size"/>

                    <ComboBox x:Name="SizeComboBox"
                              Grid.Row="3" Grid.Column="1"
                              Margin="4" Padding="5"
                              IsEditable="True"
                              Text="Medium"
                              SelectedIndex="2">
                        <ComboBoxItem Content="Tiny"/>
                        <ComboBoxItem Content="Small"/>
                        <ComboBoxItem Content="Medium"/>
                        <ComboBoxItem Content="Large"/>
                        <ComboBoxItem Content="Huge"/>
                        <ComboBoxItem Content="Gargantuan"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <Label Grid.Row="4" Grid.Column="0"
                           Content="Alignment"/>

                    <ComboBox x:Name="AlignmentComboBox"
                              Grid.Row="4" Grid.Column="1"
                              Margin="4" Padding="5"
                              IsEditable="True"
                              Text="Unaligned"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Unaligned"/>
                        <ComboBoxItem Content="Lawful Good"/>
                        <ComboBoxItem Content="Neutral Good"/>
                        <ComboBoxItem Content="Chaotic Good"/>
                        <ComboBoxItem Content="Lawful Neutral"/>
                        <ComboBoxItem Content="True Neutral"/>
                        <ComboBoxItem Content="Neutral"/>
                        <ComboBoxItem Content="Chaotic Neutral"/>
                        <ComboBoxItem Content="Lawful Evil"/>
                        <ComboBoxItem Content="Neutral Evil"/>
                        <ComboBoxItem Content="Chaotic Evil"/>
                        <ComboBoxItem Content="Any Alignment"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox>

                    <Label Grid.Row="5" Grid.Column="0"
                           Content="Description"
                           VerticalAlignment="Top"/>

                    <TextBox x:Name="DescriptionTextBox"
                             Grid.Row="5" Grid.Column="1"
                             Margin="4" Padding="6"
                             MinHeight="90"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>
                </Grid>
            </GroupBox>

            <!-- Combat statistics -->
            <GroupBox Grid.Row="2"
                      Grid.ColumnSpan="2"
                      Header="Combat Statistics"
                      Padding="12"
                      Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0"
                           Content="Armor Class"/>

                    <TextBox x:Name="ArmorClassTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="0" Grid.Column="2"
                           Content="Hit Points"/>

                    <TextBox x:Name="HitPointsTextBox"
                             Grid.Row="0" Grid.Column="3"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="1" Grid.Column="0"
                           Content="Initiative Modifier"/>

                    <TextBox x:Name="InitiativeModifierTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="1" Grid.Column="2"
                           Content="Proficiency Bonus"/>

                    <TextBox x:Name="ProficiencyBonusTextBox"
                             Grid.Row="1" Grid.Column="3"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="2" Grid.Column="0"
                           Content="Challenge Rating"/>

                    <TextBox x:Name="ChallengeRatingTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="2" Grid.Column="2"
                           Content="Experience Points"/>

                    <TextBox x:Name="ExperiencePointsTextBox"
                             Grid.Row="2" Grid.Column="3"
                             Margin="4" Padding="6"/>

                    <Label Grid.Row="3" Grid.Column="0"
                           Content="Hit Dice"
                           VerticalAlignment="Top"/>

                    <TextBox x:Name="HitDiceTextBox"
                             Grid.Row="3" Grid.Column="1"
                             Margin="4" Padding="6"
                             ToolTip="Example: 6d8 + 18"/>

                    <Label Grid.Row="3" Grid.Column="2"
                           Content="AC Notes"
                           VerticalAlignment="Top"/>

                    <TextBox x:Name="ArmorClassNotesTextBox"
                             Grid.Row="3" Grid.Column="3"
                             Margin="4" Padding="6"
                             MinHeight="55"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </GroupBox>

            <!-- Ability scores -->
            <GroupBox Grid.Row="3"
                      Grid.ColumnSpan="2"
                      Header="Ability Scores"
                      Padding="12"
                      Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Strength -->
                    <Label Grid.Row="0" Grid.Column="0"
                           Content="Strength (STR)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="StrengthTextBox"
                             Grid.Row="0" Grid.Column="1"
                             Margin="4" Padding="6"
                             Text="10"/>

                    <!-- Dexterity -->
                    <Label Grid.Row="0" Grid.Column="2"
                           Content="Dexterity (DEX)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="DexterityTextBox"
                             Grid.Row="0" Grid.Column="3"
                             Margin="4" Padding="6"
                             Text="10"/>

                    <!-- Constitution -->
                    <Label Grid.Row="1" Grid.Column="0"
                           Content="Constitution (CON)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="ConstitutionTextBox"
                             Grid.Row="1" Grid.Column="1"
                             Margin="4" Padding="6"
                             Text="10"/>

                    <!-- Intelligence -->
                    <Label Grid.Row="1" Grid.Column="2"
                           Content="Intelligence (INT)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="IntelligenceTextBox"
                             Grid.Row="1" Grid.Column="3"
                             Margin="4" Padding="6"
                             Text="10"/>

                    <!-- Wisdom -->
                    <Label Grid.Row="2" Grid.Column="0"
                           Content="Wisdom (WIS)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="WisdomTextBox"
                             Grid.Row="2" Grid.Column="1"
                             Margin="4" Padding="6"
                             Text="10"/>

                    <!-- Charisma -->
                    <Label Grid.Row="2" Grid.Column="2"
                           Content="Charisma (CHA)"
                           VerticalAlignment="Center"/>

                    <TextBox x:Name="CharismaTextBox"
                             Grid.Row="2" Grid.Column="3"
                             Margin="4" Padding="6"
                             Text="10"/>
                </Grid>
            </GroupBox>


            <!-- Creature images -->
            <GroupBox Grid.Row="4"
                      Grid.ColumnSpan="2"
                      Header="Creature Images"
                      Padding="12"
                      Margin="0,0,0,16">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,10">

                        <Button x:Name="ImportImageButton"
                                Content="Import Image"
                                Width="110"
                                Margin="0,0,8,0"
                                Padding="6"
                                Click="ImportImage_Click"/>

                        <Button x:Name="SetPrimaryImageButton"
                                Content="Set as Primary"
                                Width="110"
                                Margin="0,0,8,0"
                                Padding="6"
                                Click="SetPrimaryImage_Click"/>

                        <Button x:Name="DeleteImageButton"
                                Content="Delete Image"
                                Width="110"
                                Padding="6"
                                Click="DeleteImage_Click"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <ListBox x:Name="CreatureImagesListBox"
                                 Grid.Column="0"
                                 MinHeight="120"
                                 MaxHeight="200"
                                 Margin="0,0,12,0"
                                 DisplayMemberPath="Caption"
                                 SelectionChanged="CreatureImagesListBox_SelectionChanged"/>

                        <Border Grid.Column="1"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Background="#F3F3F3"
                                Padding="5">

                            <Image x:Name="CreatureImagePreview"
                                   Stretch="Uniform"
                                   Height="180"/>
                        </Border>
                    </Grid>
                </Grid>
            </GroupBox>

            <!-- Save and Cancel -->
            <StackPanel Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,4,0,0">

                <Button Content="Save"
                        Width="100"
                        Margin="5"
                        Padding="8"
                        Click="Save_Click"/>

                <Button Content="Cancel"
                        Width="100"
                        Margin="5"
                        Padding="8"
                        Click="Cancel_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
