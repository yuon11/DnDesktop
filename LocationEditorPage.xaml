<Page x:Class="DnDesktop.LocationEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DnDesktop"
      mc:Ignorable="d"
      d:DesignHeight="800"
      d:DesignWidth="900"
      Title="LocationEditorPage">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">

        <Grid Margin="24"
              MaxWidth="900"
              HorizontalAlignment="Left">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Location title -->
            <TextBlock x:Name="EditorTitle"
                       Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="Create Location"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- Name -->
            <Label Grid.Row="1" Content="Name *"/>
            <TextBox x:Name="NameTextBox"
                     Grid.Row="1" Grid.Column="1"
                     Margin="4" Padding="5"/>

            <!-- Location type -->
            <Label Grid.Row="2" Content="Location Type"/>
            <ComboBox x:Name="LocationTypeComboBox"
                      Grid.Row="2" Grid.Column="1"
                      Margin="4" Padding="5"
                      SelectedIndex="0">
                <ComboBoxItem Content="Other"/>
                <ComboBoxItem Content="World"/>
                <ComboBoxItem Content="Continent"/>
                <ComboBoxItem Content="Region"/>
                <ComboBoxItem Content="City"/>
                <ComboBoxItem Content="Town or Village"/>
                <ComboBoxItem Content="Building"/>
                <ComboBoxItem Content="Tavern"/>
                <ComboBoxItem Content="Dungeon"/>
                <ComboBoxItem Content="Room"/>
                <ComboBoxItem Content="Wilderness"/>
                <ComboBoxItem Content="Landmark"/>
            </ComboBox>

            <!-- Parent location -->
            <Label Grid.Row="3" Content="Parent Location"/>
            <ComboBox x:Name="ParentLocationComboBox"
                      Grid.Row="3" Grid.Column="1"
                      Margin="4" Padding="5"
                      DisplayMemberPath="Name"
                      SelectedValuePath="Id"/>

            <!-- Description -->
            <Label Grid.Row="4" Content="Description"/>
            <TextBox x:Name="DescriptionTextBox"
                     Grid.Row="4" Grid.Column="1"
                     Margin="4" Padding="5"
                     Height="90"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Population -->
            <Label Grid.Row="5" Content="Population"/>
            <TextBox x:Name="PopulationTextBox"
                     Grid.Row="5" Grid.Column="1"
                     Margin="4" Padding="5"/>

            <!-- Government -->
            <Label Grid.Row="6" Content="Government / Ruler"/>
            <TextBox x:Name="GovernmentTextBox"
                     Grid.Row="6" Grid.Column="1"
                     Margin="4" Padding="5"/>

            <!-- Notable NPCs -->
            <Label Grid.Row="7" Content="Notable NPCs"/>
            <TextBox x:Name="NotableNPCsTextBox"
                     Grid.Row="7" Grid.Column="1"
                     Margin="4" Padding="5"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Points of interest -->
            <Label Grid.Row="8" Content="Points of Interest"/>
            <TextBox x:Name="PointsOfInterestTextBox"
                     Grid.Row="8" Grid.Column="1"
                     Margin="4" Padding="5"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- GM notes -->
            <Label Grid.Row="9" Content="GM Notes"/>
            <TextBox x:Name="GMNotesTextBox"
                     Grid.Row="9" Grid.Column="1"
                     Margin="4" Padding="5"
                     Height="100"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <!-- Images heading -->
            <TextBlock Grid.Row="10"
                       Grid.ColumnSpan="2"
                       Text="Location Images"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,20,0,8"/>

            <!-- Image actions -->
            <StackPanel Grid.Row="11"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">

                <Button x:Name="AddImageButton"
                        Content="Add Images..."
                        Padding="12,6"
                        Margin="0,0,8,0"
                        Click="AddImage_Click"/>

                <Button x:Name="RemoveImageButton"
                        Content="Remove Selected"
                        Padding="12,6"
                        IsEnabled="False"
                        Click="RemoveImage_Click"/>
            </StackPanel>

            <!-- Image preview list -->
            <ListBox x:Name="LocationImagesList"
                     Grid.Row="12"
                     Grid.ColumnSpan="2"
                     MinHeight="130"
                     MaxHeight="260"
                     Margin="0,0,0,12"
                     SelectionMode="Single"
                     SelectionChanged="LocationImagesList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="LightGray"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8"
                                Margin="3">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Image Width="90"
                                       Height="75"
                                       Stretch="UniformToFill">
                                    <Image.Source>
                                        <BitmapImage UriSource="{Binding ImagePath}" CacheOption="OnLoad" />
                                    </Image.Source>
                                </Image>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center">

                                    <TextBlock Text="{Binding Caption}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"/>

                                    <TextBlock Text="{Binding ImageCategory}"
                                               Foreground="Gray"
                                               Margin="0,4,0,0"/>

                                    <TextBlock Text="Primary Image"
                                               Foreground="DarkGreen"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPrimary}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Selected image metadata -->
            <GroupBox Grid.Row="13"
                      Grid.ColumnSpan="2"
                      Header="Selected Image Details"
                      Padding="10"
                      Margin="0,0,0,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Content="Caption"/>

                    <TextBox x:Name="ImageCaptionTextBox"
                             Grid.Row="0"
                             Grid.Column="1"
                             Margin="4"
                             Padding="5"
                             IsEnabled="False"/>

                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Content="Category"/>

                    <ComboBox x:Name="ImageCategoryComboBox"
                              Grid.Row="1"
                              Grid.Column="1"
                              Margin="4"
                              Padding="5"
                              IsEnabled="False">
                        <ComboBoxItem Content="Other"/>
                        <ComboBoxItem Content="Map"/>
                        <ComboBoxItem Content="BattleMap"/>
                        <ComboBoxItem Content="Landscape"/>
                        <ComboBoxItem Content="Portrait"/>
                        <ComboBoxItem Content="Interior"/>
                        <ComboBoxItem Content="Exterior"/>
                        <ComboBoxItem Content="Handout"/>
                        <ComboBoxItem Content="Reference"/>
                    </ComboBox>

                    <CheckBox x:Name="PrimaryImageCheckBox"
                              Grid.Row="2"
                              Grid.Column="1"
                              Content="Use as primary image"
                              Margin="8"
                              IsEnabled="False"/>

                    <Button x:Name="SaveImageDetailsButton"
                            Grid.Row="3"
                            Grid.Column="1"
                            Content="Save Image Details"
                            HorizontalAlignment="Left"
                            Padding="12,6"
                            Margin="4"
                            IsEnabled="False"
                            Click="SaveImageDetails_Click"/>
                </Grid>
            </GroupBox>

            <!-- Save and Cancel -->
            <StackPanel Grid.Row="14"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,20,0,0"
                        VerticalAlignment="Bottom">

                <Button Content="Save"
                        Width="100"
                        Margin="5"
                        Padding="8"
                        Click="Save_Click"/>

                <Button Content="Cancel"
                        Width="100"
                        Margin="5"
                        Padding="8"
                        Click="Cancel_Click"/>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</Page>
