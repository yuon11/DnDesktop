<Window x:Class="DnDesktop.QuestEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quest Editor"
        Height="650"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">

            <TextBlock x:Name="WindowTitleText"
                       Text="Create Quest"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Quest Name *"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="NameTextBox"
                     Padding="8"
                     MaxLength="200"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Description"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="DescriptionTextBox"
                     Padding="8"
                     MinHeight="90"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,15"/>

            <TextBlock Text="Quest Giver"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="QuestGiverComboBox"
                      DisplayMemberPath="Name"
                      Padding="6"
                      Margin="0,0,0,15"/>

            <TextBlock Text="Status"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <ComboBox x:Name="StatusComboBox"
                      Padding="6"
                      SelectedIndex="0"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Not Started"/>
                <ComboBoxItem Content="In Progress"/>
                <ComboBoxItem Content="Completed"/>
                <ComboBoxItem Content="On Hold"/>
            </ComboBox>

            <TextBlock Text="Quest Notes"
                       FontWeight="SemiBold"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="NotesTextBox"
                     Padding="8"
                     MinHeight="100"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Save Quest"
                        Click="SaveQuest_Click"
                        Padding="15,8"
                        Margin="5"/>

                <Button Content="Cancel"
                        Click="Cancel_Click"
                        Padding="15,8"
                        Margin="5"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
