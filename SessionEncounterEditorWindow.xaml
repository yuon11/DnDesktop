<Window x:Class="DnDesktop.SessionEncounterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encounter Editor"
        Height="650"
        Width="750"
        MinHeight="550"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Encounter Name"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="NameTextBox"
                         Padding="6"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Encounter Notes"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="EncounterNotesTextBox"
                         MinHeight="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6"
                         Margin="0,0,0,15"/>

                <Separator Margin="0,5,0,15"/>

                <TextBlock Text="Creatures"
                           FontSize="18"
                           FontWeight="Bold"
                           Margin="0,0,0,8"/>

                <TextBlock
                    Text="Select a creature, specify its quantity, and add it to this encounter."
                    TextWrapping="Wrap"
                    Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="CreatureComboBox"
                              Grid.Column="0"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              Padding="6"
                              Margin="0,0,8,0"/>

                    <TextBox x:Name="QuantityTextBox"
                             Grid.Column="1"
                             Text="1"
                             Padding="6"
                             Margin="0,0,8,0"
                             ToolTip="Number of this creature"/>

                    <Button Grid.Column="2"
                            Content="Add Creature"
                            Click="AddCreature_Click"
                            Padding="10,5"/>
                </Grid>

                <ListView x:Name="EncounterCreaturesListView"
                          MinHeight="150"
                          MaxHeight="250"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Creature"
                                            Width="250"
                                            DisplayMemberBinding="{Binding CreatureName}"/>

                            <GridViewColumn Header="Quantity"
                                            Width="100"
                                            DisplayMemberBinding="{Binding Quantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,8,0,15">
                    <Button Content="Remove Selected"
                            Click="RemoveCreature_Click"
                            Padding="10,5"
                            Margin="4"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Save"
                    Click="Save_Click"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="5"/>

            <Button Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
