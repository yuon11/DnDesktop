<Window x:Class="DnDesktop.SessionEncounterEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encounter Editor"
        Height="650"
        Width="750"
        MinHeight="550"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Encounter Name"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="NameTextBox"
                         Padding="6"
                         Margin="0,0,0,15"/>

                <TextBlock Text="Encounter Notes"
                           FontWeight="Bold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="EncounterNotesTextBox"
                         MinHeight="100"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="6"
                         Margin="0,0,0,15"/>

                <Separator Margin="0,5,0,15"/>

                <GroupBox Header="Combatants" Margin="5" Padding="10">
                    <StackPanel>
                        <TextBlock Text="Select a combatant to add:"
                                   Margin="0,0,0,5" />
                        <ComboBox
                            x:Name="CombatParticipantComboBox"
                            Width="300"
                            Height="30"
                            Margin="5"
                            IsEditable="False"
                            IsEnabled="True"
                            Visibility="Visible"
                            Background="White"
                            Foreground="Black"
                            FontSize="14"
                            Style="{x:Null}" />

                        <Button
            Content="Add Combatant"
            Click="AddCombatant_Click"
            Width="140"
            HorizontalAlignment="Left"
            Margin="0,0,0,10" />


                        <ListView
    x:Name="CombatantsListView"
    Height="180"
    MinWidth="400"
    ScrollViewer.HorizontalScrollBarVisibility="Auto">

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Header="Name"
                                        DisplayMemberBinding="{Binding DisplayName}"
                                        Width="150" />

                                    <GridViewColumn
                                        Header="Type"
                                        DisplayMemberBinding="{Binding ParticipantType}"
                                        Width="85" />

                                    <GridViewColumn
                                        Header="Initiative"
                                        DisplayMemberBinding="{Binding Initiative}"
                                        Width="70" />

                                    <GridViewColumn
                                        Header="HP"
                                        DisplayMemberBinding="{Binding CurrentHP}"
                                        Width="50" />

                                    <GridViewColumn
                                        Header="Conditions"
                                        DisplayMemberBinding="{Binding Conditions}"
                                        Width="150" />

                                    <GridViewColumn
                                        Header="Defeated"
                                        DisplayMemberBinding="{Binding IsDefeated}"
                                        Width="65" />
                                </GridView>
                            </ListView.View>
                        </ListView>



                        <Button Content="Edit Selected"
                                Click="EditCombatant_Click"
                                Width="140"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"/>

                        <Button Content="Remove Selected"
                                Click="RemoveCombatant_Click"
                                Width="140"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0" />
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">

            <Button Content="Save"
                    Click="Save_Click"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="5"/>

            <Button Content="Cancel"
                    Click="Cancel_Click"
                    MinWidth="90"
                    Padding="10,6"
                    Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
